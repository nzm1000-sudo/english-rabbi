    {
      "id": "gr.past.irregular.go",
      "type": "typed",
      "skill": "grammar.past-simple.irregular",
      "level": "A2",
      "difficulty": 0.3,
      "prompt": "Yesterday I ___ to the park. (go)",
      "instruction": {
        "he": "להשלים את המילה החסרה",
        "en": "Fill in the missing word"
      },
      "answers": [
        "went"
      ],
      "knownErrors": [
        {
          "answer": "goed",
          "misconception": "past-simple.overregularization",
          "feedback": {
            "he": "go הוא פועל חריג, ולכן לא goed.",
            "en": "go is irregular, so not goed."
          }
        },
        {
          "answer": "go",
          "feedback": {
            "he": "yesterday מבקש עבר.",
            "en": "yesterday needs the past."
          }
        }
      ],
      "explanation": {
        "he": "go הוא פועל חריג. העבר שלו: went.",
        "en": "go is irregular. Its past form is went."
      },
      "hints": [
        {
          "he": "yesterday = אתמול. צריך עבר.",
          "en": "yesterday means past."
        },
        {
          "he": "זה פועל חריג. לא מוסיפים ed.",
          "en": "It is irregular. Do not add -ed."
        }
      ],
      "interests": [],
      "tags": [
        "grammar"
      ],
      "estimatedTimeSec": 20,
      "source": "original",
      "audioText": "Yesterday I went to the park."
    },

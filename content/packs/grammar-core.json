    {
      "id": "gr.ps.third-person.walk",
      "type": "typed",
      "skill": "grammar.present-simple.third-person",
      "level": "A1",
      "difficulty": 0.3,
      "prompt": "She ___ to school every day. (walk)",
      "instruction": {
        "he": "להשלים את המילה החסרה",
        "en": "Fill in the missing word"
      },
      "answers": [
        "walks"
      ],
      "knownErrors": [
        {
          "answer": "walk",
          "misconception": "present-simple.missing-s",
          "feedback": {
            "he": "כמעט. עם she מוסיפים s.",
            "en": "Almost. With she, add -s."
          }
        }
      ],
      "explanation": {
        "he": "she בהווה פשוט: מוסיפים s. She walks.",
        "en": "With she in the Present Simple, add -s: She walks."
      },
      "hints": [
        {
          "he": "מי עושה את הפעולה? she. מה מוסיפים לפועל?",
          "en": "Who does it? she. What do we add to the verb?"
        }
      ],
      "interests": [],
      "tags": [
        "grammar"
      ],
      "estimatedTimeSec": 20,
      "source": "original",
      "audioText": "She walks to school every day."
    },
    {
      "id": "gr.ps.third-person.watch",
      "type": "typed",
      "skill": "grammar.present-simple.third-person",
      "level": "A1",
      "difficulty": 0.6,
      "prompt": "My brother ___ TV after dinner. (watch)",
      "instruction": {
        "he": "להשלים את המילה החסרה",
        "en": "Fill in the missing word"
      },
      "answers": [
        "watches"
      ],
      "knownErrors": [
        {
          "answer": "watch",
          "misconception": "present-simple.missing-s",
          "feedback": {
            "he": "my brother זה he, ולכן צריך es.",
            "en": "my brother is he, so add -es."
          }
        },
        {
          "answer": "watchs",
          "feedback": {
            "he": "כמעט. אחרי ch מוסיפים es.",
            "en": "Almost. After ch, add -es."
          }
        }
      ],
      "explanation": {
        "he": "פועל שמסתיים ב־ch מקבל es: watches.",
        "en": "Verbs ending in -ch take -es: watches."
      },
      "hints": [
        {
          "he": "my brother = he. מוסיפים s או es?",
          "en": "my brother = he. Add -s or -es?"
        }
      ],
      "interests": [
        "movies"
      ],
      "tags": [
        "grammar"
      ],
      "estimatedTimeSec": 20,
      "source": "original",
      "audioText": "My brother watches TV after dinner."

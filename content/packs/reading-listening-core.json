    {
      "id": "read.garden.where",
      "type": "choice",
      "skill": "reading.details",
      "level": "A2",
      "difficulty": 0.3,
      "prompt": "Where did the students start the garden?",
      "instruction": {
        "he": "לבחור את התשובה הנכונה",
        "en": "Choose the correct answer"
      },
      "options": [
        {
          "id": "a",
          "text": "Behind their school"
        },
        {
          "id": "b",
          "text": "In a public park"
        },
        {
          "id": "c",
          "text": "On the school roof"
        }
      ],
      "correctOptionId": "a",
      "explanation": {
        "he": "כתוב בשורה הראשונה: behind their school.",
        "en": "The first sentence says: behind their school."
      },
      "hints": [
        {
          "he": "התשובה נמצאת במשפט הראשון.",
          "en": "The answer is in the first sentence."
        }
      ],
      "source": "original",
      "estimatedTimeSec": 25,
      "passageId": "passage.school-garden",
      "interests": [
        "school"
      ]
    },
    {
      "id": "read.garden.tf-believed",
      "type": "choice",
      "skill": "reading.true-false",
      "level": "A2",
      "difficulty": 0.4,
      "prompt": "True or false: At first, everyone was sure the garden would succeed.",
